// tangnano20k.cst -- physical constraints for spark_board_top on the Sipeed
// Tang Nano 20K (GW2AR-LV18QN88C8/I7).
// Pins follow the Sipeed Tang Nano 20K examples/wiki as remembered at the time
// of writing. Every line marked TODO must be checked against the Sipeed wiki
// (wiki.sipeed.com/hardware/en/tang/tang-nano-20k/nano-20k.html) and the board
// schematic before programming.

// 27 MHz crystal oscillator
IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// UART to the onboard BL616 USB-UART bridge (FPGA-side names).
// TODO: confirm 69 = FPGA TX (to BL616 RX) and 70 = FPGA RX on your board revision.
IO_LOC  "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// User LEDs 0..5, active low.
IO_LOC  "led_n[0]" 15;
IO_LOC  "led_n[1]" 16;
IO_LOC  "led_n[2]" 17;
IO_LOC  "led_n[3]" 18;
IO_LOC  "led_n[4]" 19;
IO_LOC  "led_n[5]" 20;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// Push buttons. S1 = 88 (used as reset), S2 = 87 (unused).
// TODO: check polarity in the schematic. The RTL assumes pressed = logic 1
// (button to 3V3 with pull-down). If your board reads 0 when pressed, invert
// btn_s1 in spark_board_top.v, otherwise the design is held in reset.
IO_LOC  "btn_s1" 88;
IO_PORT "btn_s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "btn_s2" 87;
IO_PORT "btn_s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// Benchmark marker output -> ESP32 GPIO4 (3.3 V logic, common GND).
// TODO: pin 76 is a GUESS for a free pin on the 2x20 header; check the pinout
// diagram on the Sipeed wiki and pick any free 3.3 V header pin, then update
// this line. (The host can also mark start/stop in software over the ESP32
// serial port, so this pin is optional.)
IO_LOC  "trig_out" 76;
IO_PORT "trig_out" IO_TYPE=LVCMOS33 DRIVE=8;
