# SPARK Cortex (core + sensory encoder + UART top) -> SkyWater SKY130 sky130_fd_sc_hd, typical corner.
# Big memories (table, dream counts, list buffer) become OpenRAM 2 KB macros via sram_array (CORTEX_ASIC);
# the encoder's small memories become flip-flops, each on its own gated clock (sky130 dlclkp cells, CG_SKY130).
read_liberty -lib /opt/sky130_sram_macros/sky130_sram_2kbyte_1rw1r_32x512_8/sky130_sram_2kbyte_1rw1r_32x512_8_TT_1p8V_25C.lib
read_liberty -lib ../syn/hd_tt_dontuse.lib
read_verilog -DCORTEX_ASIC -DCG_SKY130 ../../rtl/cortex/cortex_core.v ../../rtl/cortex/cortex_encoder.v ../../rtl/cortex/cortex_cg.v ../spark_mem_sky130.v \
  ../../board/uart_rx.v ../../board/uart_tx.v ../../board/cortex_board_top.v
hierarchy -check -top cortex_board_top
synth -top cortex_board_top -flatten
memory_map
opt
dfflibmap -liberty ../syn/hd_tt_dontuse.lib
abc -D 20000 -liberty ../syn/hd_tt_dontuse.lib
setundef -zero
splitnets -ports
opt_clean -purge
hilomap -hicell sky130_fd_sc_hd__conb_1 HI -locell sky130_fd_sc_hd__conb_1 LO
insbuf -buf sky130_fd_sc_hd__buf_2 A X
opt_clean -purge
tee -o synth_stat.txt stat -liberty /opt/eda_pdk/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -liberty /opt/sky130_sram_macros/sky130_sram_2kbyte_1rw1r_32x512_8/sky130_sram_2kbyte_1rw1r_32x512_8_TT_1p8V_25C.lib
write_verilog -noattr -noexpr -nohex -nodec cortex_syn.v
